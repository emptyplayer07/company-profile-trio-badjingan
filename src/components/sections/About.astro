---
import Container from "../common/Container.astro";
---

<section id="about" class="bg-base-200 py-24 lg:py-32">
  <Container>

    <div class="grid items-center gap-16 lg:grid-cols-2">

      <!-- Visual -->
      <div>
        <div class="relative overflow-hidden rounded-[2rem] bg-primary p-8 lg:p-12">

          <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10"></div>

          <div class="relative">
            <span class="text-sm font-medium text-primary-content/70">
              ABOUT OUR COMPANY
            </span>

            <h2 class="mt-4 text-4xl font-bold leading-tight text-primary-content lg:text-5xl">
              Building The Future
              With Technology
            </h2>

            <p class="mt-6 leading-8 text-primary-content/70">
              We combine technology, creativity, and business
              understanding to create solutions that help
              organizations grow.
            </p>
          </div>

        </div>
      </div>

      <!-- Content -->
      <div>

        <span class="text-sm font-semibold uppercase tracking-widest text-primary">
          About Us
        </span>

        <h2 class="mt-4 text-4xl font-bold leading-tight lg:text-5xl">
          Your trusted technology partner
        </h2>

        <p class="mt-6 leading-8 text-base-content/60">
          Our team delivers reliable and scalable technology
          solutions designed around your business needs.
        </p>

        <div class="mt-8 space-y-5">

          <div class="flex gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
              ✓
            </div>

            <div>
              <h3 class="font-bold">
                Experienced Team
              </h3>

              <p class="mt-1 text-sm text-base-content/60">
                Skilled professionals with experience across
                multiple technology fields.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
              ✓
            </div>

            <div>
              <h3 class="font-bold">
                Modern Technology
              </h3>

              <p class="mt-1 text-sm text-base-content/60">
                We use modern technologies to create efficient
                and scalable solutions.
              </p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
              ✓
            </div>

            <div>
              <h3 class="font-bold">
                Customer Focused
              </h3>

              <p class="mt-1 text-sm text-base-content/60">
                Every solution is designed around the goals
                and challenges of our clients.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </Container>
</section>