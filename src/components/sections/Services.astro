---
import Container from "../common/Container.astro";

const services = [
  {
    title: "Web Development",
    description:
      "Modern, responsive, and scalable websites designed to support your business.",
    icon: "web",
  },
  {
    title: "Mobile Development",
    description:
      "High-quality mobile applications for Android and iOS platforms.",
    icon: "mobile",
  },
  {
    title: "IT Consulting",
    description:
      "Technology strategies that align your IT infrastructure with business goals.",
    icon: "consulting",
  },
];
---

<section id="services" class="services-section bg-base-100 py-24 lg:py-32">
  <Container>

    <!-- SECTION HEADER -->
    <div class="services-header mx-auto max-w-2xl text-center">

      <span
        class="text-lg font-bold uppercase tracking-widest text-primary"
      >
        Our Services
      </span>

      <h2
        class="mt-4 text-4xl font-bold leading-tight text-black lg:text-5xl"
      >
        Technology solutions
        <br />
        <span class="mt-2 inline-block">built for you</span>
      </h2>

      <p class="mt-6 text-base-content/60">
        From strategy to implementation, we provide the technology expertise
        your business needs.
      </p>

    </div>


    <!-- SERVICES -->
    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <article
          class={`service-card group rounded-3xl border border-base-200 bg-base-100 p-8 shadow-[0_10px_30px_rgba(15,23,42,0.08)] transition-all duration-500 ease-out will-change-transform hover:-translate-y-2 hover:border-primary/30 hover:shadow-[0_20px_40px_rgba(15,23,42,0.12)]`}
          style={`--delay: ${index * 0.15}s`}
        >

          <!-- ICON -->
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-all duration-500 ease-out group-hover:bg-primary group-hover:text-primary-content group-hover:scale-105">

            <!-- WEB DEVELOPMENT -->
            {service.icon === "web" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
                class="h-7 w-7 transition-transform duration-500 ease-out group-hover:scale-110"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m8.25 9-3 3 3 3m7.5-6 3 3-3 3M14.25 6l-4.5 12"
                />
              </svg>
            )}

            <!-- MOBILE DEVELOPMENT -->
            {service.icon === "mobile" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
                class="h-7 w-7 transition-transform duration-300 group-hover:scale-110"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M10.5 2.25h3A2.25 2.25 0 0 1 15.75 4.5v15A2.25 2.25 0 0 1 13.5 21.75h-3a2.25 2.25 0 0 1-2.25-2.25v-15A2.25 2.25 0 0 1 10.5 2.25Z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11.25 18.75h1.5"
                />
              </svg>
            )}

            <!-- IT CONSULTING -->
            {service.icon === "consulting" && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.8"
                stroke="currentColor"
                class="h-7 w-7 transition-transform duration-300 group-hover:scale-110"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13l-2.685.805.805-2.685a4.5 4.5 0 0 1 1.13-1.897L16.862 4.487Z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 7.125 16.875 4.5"
                />
              </svg>
            )}

          </div>

          <!-- TITLE -->
          <h3 class="mt-7 text-xl font-bold">
            {service.title}
          </h3>

          <!-- DESCRIPTION -->
          <p class="mt-4 leading-7 text-base-content/60">
            {service.description}
          </p>

        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  /* SECTION HEADER */
  .services-header {
    opacity: 0;
    transform: translateY(35px);
    animation: servicesHeaderFade 1.1s ease-out forwards;
  }

  .services-section:not(.is-visible) .services-header {
    animation-play-state: paused;
  }

  /* SERVICE CARDS */
  .service-card {
    opacity: 0;
    animation: serviceCardFadeUp 1s ease-out forwards;
    animation-delay: var(--delay);
    animation-play-state: paused;
  }

  .services-section.is-visible .service-card {
    animation-play-state: running;
  }

  @keyframes servicesHeaderFade {
    from {
      opacity: 0;
      transform: translateY(35px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes serviceCardFadeUp {
    from {
      opacity: 0;
      transform: translateY(45px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* REDUCE MOTION */
  @media (prefers-reduced-motion: reduce) {
    .services-header,
    .service-card {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>


<script>
  const servicesSection = document.querySelector(".services-section");
  if (servicesSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");

            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.2,
      }
    );

    observer.observe(servicesSection);
  }
</script>