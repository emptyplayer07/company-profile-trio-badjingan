---
import Container from "../common/Container.astro";
---

<section id="contact" class="contact-section bg-base-200 py-24 lg:py-32">
  <Container>
    <div
      class="contact-card relative overflow-hidden rounded-[2.5rem] bg-primary px-8 py-16 text-center lg:px-20 lg:py-24"
    >
      <!-- Decorative circles -->
      <div
        class="contact-decoration contact-decoration-left absolute -left-20 -top-20 h-64 w-64 rounded-full bg-white/10"
      ></div>

      <div
        class="contact-decoration contact-decoration-right absolute -bottom-20 -right-20 h-72 w-72 rounded-full bg-white/10"
      ></div>

      <!-- Content -->
      <div class="contact-content relative mx-auto max-w-3xl">

        <!-- Label -->
        <span
          class="contact-label text-sm font-semibold uppercase tracking-widest text-primary-content/70"
        >
          Let's Work Together
        </span>

        <!-- Heading -->
        <h2
          class="contact-title mt-5 text-4xl font-bold text-primary-content lg:text-6xl"
        >
          Have an idea?
          <br />
          Let's build it together.
        </h2>

        <!-- Description -->
        <p
          class="contact-description mx-auto mt-6 max-w-2xl text-lg leading-8 text-primary-content/70"
        >
          Tell us about your project and discover how technology
          can help your business grow.
        </p>

        <!-- Buttons -->
        <div
          class="contact-buttons mt-9 flex flex-wrap justify-center gap-4"
        >
          <!-- WhatsApp -->
          <a
            href="https://wa.me/628xxxxxxxxxx"
            target="_blank"
            rel="noopener noreferrer"
            class="btn rounded-full border-0 bg-white px-7 text-primary transition-all duration-500 hover:-translate-y-1 hover:bg-white/90 hover:shadow-lg"
          >
            <!-- WhatsApp Icon -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01-.198 0-.52.074-.792.372-.273.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
              />
              <path
                d="M20.52 3.449A11.815 11.815 0 0 0 12.04 0C5.495 0 .16 5.335.16 11.88c0 2.093.547 4.136 1.588 5.94L.093 24l6.335-1.632a11.9 11.9 0 0 0 5.607 1.426h.005c6.545 0 11.88-5.335 11.88-11.88 0-3.174-1.236-6.158-3.4-8.465zM12.04 21.79a9.89 9.89 0 0 1-5.042-1.378l-.361-.214-3.758.968 1.003-3.665-.235-.376a9.865 9.865 0 0 1-1.515-5.245c0-5.445 4.432-9.877 9.882-9.877a9.82 9.82 0 0 1 6.99 2.897 9.825 9.825 0 0 1 2.892 6.995c-.005 5.45-4.437 9.895-9.882 9.895z"
              />
            </svg>

            Chat on WhatsApp
          </a>

          <!-- Email -->
          <a
            href="mailto:hello@example.com"
            class="btn rounded-full border border-white/50 bg-transparent px-7 text-white transition-all duration-500 hover:-translate-y-1 hover:border-white hover:bg-white hover:text-primary hover:shadow-lg"
          >
            <!-- Email Icon -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.8"
              stroke="currentColor"
              class="h-5 w-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25H4.5a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0l-7.5-4.615A2.25 2.25 0 0 1 2.25 6.993V6.75"
              />
            </svg>

            Send an Email
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  /* ========================================
     Initial Content State
  ======================================== */

  .contact-content {
    opacity: 0;
    transform: translateY(70px);

    transition:
      opacity 1.2s ease-out,
      transform 1.2s ease-out;
  }

  .contact-section.is-visible .contact-content {
    opacity: 1;
    transform: translateY(0);
  }


  /* ========================================
     Label
  ======================================== */

  .contact-label {
    display: inline-block;

    opacity: 0;
    transform: translateY(25px);
  }

  .contact-section.is-visible .contact-label {
    animation: contactFadeUp 1s ease-out 0.15s forwards;
  }


  /* ========================================
     Heading
  ======================================== */

  .contact-title {
    opacity: 0;
    transform: translateY(30px);
  }

  .contact-section.is-visible .contact-title {
    animation: contactFadeUp 1.1s ease-out 0.3s forwards;
  }


  /* ========================================
     Description
  ======================================== */

  .contact-description {
    opacity: 0;
    transform: translateY(30px);
  }

  .contact-section.is-visible .contact-description {
    animation: contactFadeUp 1.1s ease-out 0.5s forwards;
  }


  /* ========================================
     Buttons
  ======================================== */

  .contact-buttons {
    opacity: 0;
    transform: translateY(30px);
  }

  .contact-section.is-visible .contact-buttons {
    animation: contactFadeUp 1.1s ease-out 0.7s forwards;
  }


  /* ========================================
     Decorative Circles
  ======================================== */

  .contact-decoration {
    opacity: 0;
  }

  .contact-section.is-visible .contact-decoration-left {
    opacity: 1;

    animation:
      contactCircleLeft 8s ease-in-out infinite,
      contactDecorationFade 1.5s ease-out forwards;
  }

  .contact-section.is-visible .contact-decoration-right {
    opacity: 1;

    animation:
      contactCircleRight 9s ease-in-out infinite,
      contactDecorationFade 1.5s ease-out forwards;
  }


  /* ========================================
     Animation
  ======================================== */

  @keyframes contactFadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  @keyframes contactDecorationFade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }


  @keyframes contactCircleLeft {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(20px, 25px);
    }
  }


  @keyframes contactCircleRight {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(-25px, -20px);
    }
  }


  /* ========================================
     Reduced Motion
  ======================================== */

  @media (prefers-reduced-motion: reduce) {
    .contact-content,
    .contact-label,
    .contact-title,
    .contact-description,
    .contact-buttons,
    .contact-decoration {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  const contactSection =
    document.querySelector<HTMLElement>(".contact-section");

  if (contactSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.2,
      },
    );

    observer.observe(contactSection);
  }
</script>