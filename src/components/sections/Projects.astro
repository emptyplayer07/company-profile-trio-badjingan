---
import Container from "../common/Container.astro";

const projects = [
  {
    title: "Business Management System",
    category: "Web Application",
    description:
      "A centralized platform designed to simplify business operations."
  },
  {
    title: "E-Commerce Platform",
    category: "Digital Commerce",
    description:
      "A modern online shopping experience optimized for performance."
  },
  {
    title: "Mobile Banking App",
    category: "Mobile Application",
    description:
      "A secure and intuitive mobile experience for financial services."
  }
];
---

<section id="projects" class="bg-base-100 py-24 lg:py-32">
  <Container>

    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">

      <div>
        <span class="text-sm font-semibold uppercase tracking-widest text-primary">
          Our Projects
        </span>

        <h2 class="mt-4 text-4xl font-bold lg:text-5xl">
          Work we're proud of
        </h2>
      </div>

      <a
        href="#contact"
        class="link link-primary font-semibold"
      >
        Start a project →
      </a>

    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-3">

      {projects.map((project) => (
        <article class="group">

          <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-base-200">

            <div class="flex h-full items-center justify-center bg-gradient-to-br from-primary/20 via-base-200 to-info/20 transition duration-500 group-hover:scale-105">

              <div class="rounded-2xl bg-base-100/80 p-8 text-center shadow-lg backdrop-blur">
                <div class="text-4xl text-primary">
                  ◇
                </div>

                <p class="mt-3 text-sm font-semibold">
                  {project.category}
                </p>
              </div>

            </div>

          </div>

          <h3 class="mt-6 text-xl font-bold">
            {project.title}
          </h3>

          <p class="mt-3 text-sm leading-6 text-base-content/60">
            {project.description}
          </p>

        </article>
      ))}

    </div>

  </Container>
</section>