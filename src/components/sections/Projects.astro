---
import Container from "../common/Container.astro";
import Image1 from "../../assets/images/hotelniagaralawang.png";
import Image2 from "../../assets/images/makercost.png";

const projects = [
  {
    title: "Hotel Niagara Lawang",
    category: "Web Development",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quisquam, voluptatibus.",
    image: Image1,
    link: "https://hotel-ui-f2052.containers.snapdeploy.app/"
  },
  {
    title: "Maker Cost",
    category: "Web Development",
    description:
      "MakerCost is a web application for calculating the cost of goods sold (COGS) and determining product selling prices.
      It is suitable for makers and production businesses, such as those involved in 3D printing.
      Calculations cover materials, labor, electricity, maintenance, and additional costs.
      It features tools for managing products and transactions, as well as generating sales reports.",
    image: Image2,
    link: "https://makercost-topaz.vercel.app/"
  },
  {
    title: "Nama Project 3",
    category: "Mobile Development",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quisquam, voluptatibus.",
    image: Image1,
    link: "https://makercost-topaz.vercel.app/"
  },
];
---

<section
  id="projects"
  class="projects-section bg-white py-24 lg:py-32"
>
  <Container>
    <!-- Section Header -->
    <div class="projects-header mx-auto max-w-2xl text-center">
      <span
        class="text-lg font-bold uppercase tracking-widest text-primary"
      >
        Our Projects
      </span>

      <h2
        class="mt-4 text-4xl font-bold leading-tight text-black lg:text-5xl"
      >
        Projects we've
        <br />
        <span class="mt-2 inline-block">worked on</span>
      </h2>

      <p class="mt-6 text-base leading-7 text-slate-600">
        A selection of projects and digital solutions we have worked on.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="project-filters mt-12 flex flex-wrap justify-center gap-3">
      <button
        type="button"
        class="project-filter active"
        data-filter="all"
      >
        All Category
      </button>

      <button
        type="button"
        class="project-filter"
        data-filter="Web Development"
      >
        Web Development
      </button>

      <button
        type="button"
        class="project-filter"
        data-filter="Mobile Development"
      >
        Mobile Development
      </button>
    </div>

    <!-- Project Cards -->
    <div class="mt-10 space-y-6 lg:mt-12">
      {
        
        projects.map((project, index) => (
          
          <article
            class="project-card group"
            data-category={project.category}
            style={`--delay: ${index * 0.2}s`}
            onclick={`window.open('${project.link}', '_blank')`}
          >
            <div class="project-card-inner">
              <!-- Project Information -->
              <div class="project-content">
                <!-- Content -->
                <div class="mt-8">
                  <span class="project-category">
                    {project.category}
                  </span>

                  <h3 class="project-title">
                    {project.title}
                  </h3>

                  <p class="project-description">
                    {project.description}
                  </p>
                </div>
              </div>

              <!-- Project Image -->
              <div class="project-image-wrapper">
                <div class="project-image">
                  <img
                    src={project.image.src}
                    alt={project.title}
                    loading="lazy"
                  />

                  <div class="project-image-overlay"></div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .projects-section {
    overflow: hidden;
  }

  /* ========================================
     SECTION HEADER
  ======================================== */

  .projects-header {
    opacity: 0;
    transform: translateY(60px);

    transition:
      opacity 1.2s ease-out,
      transform 1.2s ease-out;
  }

  .projects-section.is-visible .projects-header {
    opacity: 1;
    transform: translateY(0);
  }

  /* ========================================
     FILTER BUTTONS
  ======================================== */

  .project-filters {
    opacity: 0;
    transform: translateY(30px);

    transition:
      opacity 1s ease-out 0.15s,
      transform 1s ease-out 0.15s;
  }

  .projects-section.is-visible .project-filters {
    opacity: 1;
    transform: translateY(0);
  }

  .project-filter {
  border: 1px solid var(--color-primary);
  border-radius: 0.75rem;
  background: white;
  padding: 0.7rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-primary);
  cursor: pointer;
  transition:
    color 0.3s ease,
    background-color 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease,
    transform 0.3s ease;
}

.project-filter:hover {
  transform: translateY(-2px);
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-primary-content);
  box-shadow:
    0 8px 18px rgba(29, 78, 216, 0.2),
    0 3px 8px rgba(29, 78, 216, 0.1);
}

.project-filter.active {
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: var(--color-primary-content);
  box-shadow:
    0 8px 18px rgba(29, 78, 216, 0.2),
    0 3px 8px rgba(29, 78, 216, 0.1);
}

.project-filter.active:hover {
  transform: translateY(-2px);
  background: rgb(30 64 175);
  border-color: rgb(30 64 175);
  color: white;
}

  /* ========================================
     PROJECT CARD
  ======================================== */

  .project-card {
    cursor: pointer;
    perspective: 1400px;
    transform-style: preserve-3d;

    opacity: 0;
    transform: translateY(80px);

    animation: projectCardReveal 1.2s ease-out forwards;
    animation-delay: var(--delay);
    animation-play-state: paused;

    will-change: transform, opacity;
  }

  .projects-section.is-visible .project-card {
    animation-play-state: running;
  }

  @keyframes projectCardReveal {
    from {
      opacity: 0;
      transform: translateY(80px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========================================
     FILTER HIDDEN STATE
  ======================================== */

  .project-card.is-hidden {
    display: none;
  }

  /* ========================================
     CARD INNER
  ======================================== */

  .project-card-inner {
    position: relative;

    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);

    align-items: center;

    gap: 3rem;

    min-height: 315px;

    padding: 2.5rem;

    border: 1px solid rgb(226 232 240);
    border-radius: 1rem;

    background: white;

    transform-style: preserve-3d;

    transition:
      border-color 0.6s ease,
      box-shadow 0.6s ease;

    will-change: transform;
  }

  .project-card:hover .project-card-inner {
    border-color: rgb(203 213 225);

    box-shadow:
      0 25px 50px rgba(15, 23, 42, 0.08),
      0 10px 25px rgba(15, 23, 42, 0.04);
  }

  /* ========================================
     PROJECT CONTENT
  ======================================== */

  .project-content {
    position: relative;
    z-index: 2;

    transform: translateZ(25px);
    transform-style: preserve-3d;
  }

  .project-category {
    display: inline-block;

    font-size: 0.75rem;
    font-weight: 500;

    text-transform: uppercase;
    letter-spacing: 0.15em;

    color: rgb(100 116 139);
  }

  .project-title {
    margin-top: 1rem;

    font-size: 1.5rem;
    line-height: 1.2;

    font-weight: 700;
    letter-spacing: -0.025em;

    color: rgb(15 23 42);
  }

  .project-description {
    max-width: 36rem;

    margin-top: 1.25rem;

    font-size: 0.875rem;
    line-height: 1.75;

    color: rgb(71 85 105);
  }

  @media (min-width: 1024px) {
    .project-title {
      font-size: 1.875rem;
    }

    .project-description {
      font-size: 1rem;
    }
  }

  /* ========================================
     PROJECT IMAGE
  ======================================== */

  .project-image-wrapper {
    position: relative;
    z-index: 1;

    transform: translateZ(40px);
    transform-style: preserve-3d;
  }

  .project-image {
    position: relative;

    overflow: hidden;

    width: 100%;

    aspect-ratio: 16 / 9;

    border: 1px solid rgb(226 232 240);
    border-radius: 0.9rem;

    background: rgb(241 245 249);

    box-shadow:
      0 15px 30px rgba(15, 23, 42, 0.08),
      0 5px 15px rgba(15, 23, 42, 0.04);

    transition:
      box-shadow 0.7s ease,
      transform 0.7s ease;
  }

  .project-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.8s ease;
  }

  .project-card:hover .project-image {
    box-shadow:
      0 25px 50px rgba(15, 23, 42, 0.12),
      0 10px 25px rgba(15, 23, 42, 0.06);
  }

  .project-card:hover .project-image img {
    transform: scale(1.04);
  }

  /* ========================================
     IMAGE OVERLAY
  ======================================== */

  .project-image-overlay {
    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.08),
        transparent 40%,
        rgba(99, 102, 241, 0.05)
      );

    opacity: 0;

    transition: opacity 0.7s ease;
  }

  .project-card:hover .project-image-overlay {
    opacity: 1;
  }

  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 1023px) {
    .project-card-inner {
      grid-template-columns: 1fr;

      gap: 2rem;
    }

    .project-image-wrapper {
      order: -1;
    }
  }

  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 640px) {
    .project-filters {
      gap: 0.5rem;
    }

    .project-filter {
      padding: 0.6rem 1rem;

      font-size: 0.8rem;
    }

    .project-card-inner {
      gap: 1.75rem;

      padding: 1.5rem;
    }

    .project-content {
      transform: translateZ(0);
    }

    .project-image-wrapper {
      transform: translateZ(0);
    }

    .project-card {
      perspective: none;
    }
  }

  /* ========================================
     REDUCED MOTION
  ======================================== */

  @media (prefers-reduced-motion: reduce) {
    .projects-header,
    .project-filters {
      opacity: 1;
      transform: none;

      transition: none;
    }

    .project-card {
      opacity: 1;
      transform: none;

      animation: none;
    }

    .project-card-inner,
    .project-image,
    .project-image img,
    .project-image-overlay,
    .project-filter {
      transition: none;
    }
  }
</style>

<script>
  // ========================================
  // PROJECT SECTION REVEAL
  // ========================================

  const projectsSection =
    document.querySelector<HTMLElement>(".projects-section");

  if (projectsSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");

            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
      },
    );

    observer.observe(projectsSection);
  }

  // ========================================
  // PROJECT FILTER
  // ========================================

  const filterButtons =
    document.querySelectorAll<HTMLButtonElement>(".project-filter");

  const projectCards =
    document.querySelectorAll<HTMLElement>(".project-card");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedCategory =
        button.dataset.filter;

      if (!selectedCategory) return;

      // Update active button
      filterButtons.forEach((item) => {
        item.classList.remove("active");
      });

      button.classList.add("active");

      // Filter cards
      projectCards.forEach((card) => {
        const cardCategory =
          card.dataset.category;

        if (
          selectedCategory === "all" ||
          cardCategory === selectedCategory
        ) {
          card.classList.remove("is-hidden");
        } else {
          card.classList.add("is-hidden");
        }
      });
    });
  });

  // ========================================
  // 3D MOUSE EFFECT
  // ========================================

  projectCards.forEach((card) => {
    const inner =
      card.querySelector<HTMLElement>(
        ".project-card-inner",
      );

    if (!inner) return;

    card.addEventListener("mousemove", (event) => {
      const rect =
        card.getBoundingClientRect();

      const x =
        event.clientX - rect.left;

      const y =
        event.clientY - rect.top;

      const centerX =
        rect.width / 2;

      const centerY =
        rect.height / 2;

      const rotateX =
        ((y - centerY) / centerY) * -3;

      const rotateY =
        ((x - centerX) / centerX) * 4;

      inner.style.transform = `
        rotateX(${rotateX}deg)
        rotateY(${rotateY}deg)
      `;
    });

    card.addEventListener("mouseleave", () => {
      inner.style.transform = `
        rotateX(0deg)
        rotateY(0deg)
      `;
    });
  });
</script>
