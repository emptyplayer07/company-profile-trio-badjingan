---
import Container from "../common/Container.astro";
---

<section class="bg-base-200 py-24 lg:py-32">
  <Container>

    <div class="grid items-center gap-16 lg:grid-cols-2">

      <div>

        <span class="text-sm font-semibold uppercase tracking-widest text-primary">
          Why Choose Us
        </span>

        <h2 class="mt-4 text-4xl font-bold lg:text-5xl">
          We turn technology
          into business value.
        </h2>

        <p class="mt-6 leading-8 text-base-content/60">
          Technology should solve problems, not create them.
          That's why we focus on simple, reliable, and
          measurable solutions.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-8">

          <div>
            <p class="text-4xl font-bold text-primary">
              98%
            </p>

            <p class="mt-2 text-sm text-base-content/60">
              Client Satisfaction
            </p>
          </div>

          <div>
            <p class="text-4xl font-bold text-primary">
              24/7
            </p>

            <p class="mt-2 text-sm text-base-content/60">
              Technical Support
            </p>
          </div>

        </div>

      </div>

      <div class="grid gap-5 sm:grid-cols-2">

        <div class="rounded-3xl bg-base-100 p-7 shadow-sm">
          <div class="text-3xl">⚡</div>

          <h3 class="mt-5 font-bold">
            Fast Delivery
          </h3>

          <p class="mt-3 text-sm leading-6 text-base-content/60">
            Efficient development processes without
            sacrificing quality.
          </p>
        </div>

        <div class="rounded-3xl bg-primary p-7 text-primary-content shadow-sm">
          <div class="text-3xl">🔒</div>

          <h3 class="mt-5 font-bold">
            Secure
          </h3>

          <p class="mt-3 text-sm leading-6 text-primary-content/70">
            Security is considered throughout every
            stage of development.
          </p>
        </div>

        <div class="rounded-3xl bg-primary p-7 text-primary-content shadow-sm">
          <div class="text-3xl">📈</div>

          <h3 class="mt-5 font-bold">
            Scalable
          </h3>

          <p class="mt-3 text-sm leading-6 text-primary-content/70">
            Solutions designed to grow together with
            your business.
          </p>
        </div>

        <div class="rounded-3xl bg-base-100 p-7 shadow-sm">
          <div class="text-3xl">🤝</div>

          <h3 class="mt-5 font-bold">
            Partnership
          </h3>

          <p class="mt-3 text-sm leading-6 text-base-content/60">
            We work closely with clients throughout
            the entire journey.
          </p>
        </div>

      </div>

    </div>

  </Container>
</section>