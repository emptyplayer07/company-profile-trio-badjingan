---
import Container from "../common/Container.astro";

const approaches = [
  {
    title: "Understand First",
    description:
      "We take the time to understand your needs, goals, and the challenges behind your project before building a solution.",
    icon: "understand",
  },
  {
    title: "Build What Matters",
    description:
      "We focus on creating practical digital solutions that address your actual business needs.",
    icon: "build",
  },
  {
    title: "Clear Communication",
    description:
      "We keep communication straightforward so you can stay informed throughout the development process.",
    icon: "communication",
  },
  {
    title: "Improve Together",
    description:
      "We use feedback to refine the product and make improvements throughout the development process.",
    icon: "improve",
  },
];
---

<section
  id="why-us"
  class="why-us-section bg-base-200 py-24 lg:py-32"
>
  <Container>
    <!-- SECTION HEADER -->
    <div class="why-us-header mx-auto max-w-2xl text-center">
      <span class="text-lg font-bold uppercase tracking-widest text-primary">
        Why Work With Us
      </span>
      <h2 class="mt-4 text-4xl font-bold leading-tight text-black lg:text-5xl">
        A Simple Approach
        <br />
        <span class="mt-2 inline-block">
          to Technology
        </span>
      </h2>
      <p class="mt-6 text-base leading-7 text-slate-600">
        We focus on understanding your needs, building practical solutions,
        and keeping the process clear from start to finish.
      </p>
    </div>

    <!-- SECTION CARDS -->
    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {
        approaches.map((item, index) => (
          <article
            class="why-us-card group rounded-3xl border border-slate-200 bg-white p-8 shadow-[0_10px_30px_rgba(15,23,42,0.06)]"
            style={`--delay: ${index * 0.25}s`}
          >
            <div class="flex items-start gap-5">
              <!-- ICON -->
              <div class="why-us-icon group-hover:bg-primary flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-primary">
                {
                  item.icon === "understand" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.8"
                      stroke="currentColor"
                      class="h-7 w-7"
                      >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"
                      />

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                      />
                    </svg>
                  )
                }
                {
                  item.icon === "build" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.8"
                      stroke="currentColor"
                      class="h-7 w-7"
                    >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m21.75 13.5-9.75 6-9.75-6"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m2.25 10.5 9.75 6 9.75-6-9.75-6-9.75 6Z"
                    />

                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m2.25 13.5 9.75 6 9.75-6"
                    />
                    </svg>
                  )
                }
                {
                  item.icon === "communication" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.8"
                      stroke="currentColor"
                      class="h-7 w-7"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M7.5 8.25h9m-9 3.75h5.25"
                      />

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M20.25 11.25c0 4.556-3.694 8.25-8.25 8.25a8.2 8.2 0 0 1-3.424-.742L4.5 20.25l1.492-3.48A8.2 8.2 0 0 1 3.75 11.25C3.75 6.694 7.444 3 12 3s8.25 3.694 8.25 8.25Z"
                      />
                    </svg>
                  )
                }
                {
                  item.icon === "improve" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.8"
                      stroke="currentColor"
                      class="h-7 w-7"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 12a9 9 0 0 1 15.36-6.36L21 8.25"
                      />

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21 3v5.25h-5.25"
                      />

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M21 12a9 9 0 0 1-15.36 6.36L3 15.75"
                      />

                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 21v-5.25h5.25"
                      />
                    </svg>
                  )
                }
              </div>

              <!-- CONTENT -->
              <div>
                <h3 class="text-xl font-bold text-black">
                  {item.title}
                </h3>
                <p class="mt-3 leading-7 text-slate-600">
                  {item.description}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>


<style>

  /* =================================================
     SECTION HEADER
  ================================================= */

  .why-us-header {
    opacity: 0;
    transform: translateY(40px);

    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
  }


  .why-us-section.is-visible .why-us-header {
    opacity: 1;
    transform: translateY(0);
  }


  /* =================================================
     CARD INITIAL STATE
  ================================================= */

  .why-us-card {
    opacity: 0;
    transform: translateY(45px);

    /*
      Animation entrance.
      Tidak menggunakan transition transform
      supaya tidak bentrok dengan hover.
    */
    animation: whyUsCardFadeUp 1s ease-out forwards;

    animation-delay: var(--delay);

    animation-play-state: paused;

    /*
      Supaya hover terasa lebih smooth.
    */
    transition:
      transform 0.7s ease-out,
      border-color 0.7s ease-out,
      box-shadow 0.7s ease-out;

    will-change: transform;
  }


  /* =================================================
     START CARD ANIMATION
  ================================================= */

  .why-us-section.is-visible .why-us-card {
    animation-play-state: running;
  }


  /* =================================================
     CARD ENTRANCE ANIMATION
  ================================================= */

  @keyframes whyUsCardFadeUp {

    from {
      opacity: 0;
      transform: translateY(45px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }

  }


  /* =================================================
     CARD HOVER
  ================================================= */

  .why-us-card:hover {
    transform: translateY(-8px);

    border-color: rgb(199 210 254);

    box-shadow:
      0 20px 45px rgba(15, 23, 42, 0.10),
      0 8px 20px rgba(15, 23, 42, 0.06);
  }


  /* =================================================
     ICON
  ================================================= */

  .why-us-icon {
    transition:
      transform 0.6s ease-out,
      background-color 0.6s ease-out,
      color 0.6s ease-out;
  }


  .why-us-card:hover .why-us-icon {
    transform: scale(1.08);
    color: white;
  }


  /* =================================================
     REDUCED MOTION
  ================================================= */

  @media (prefers-reduced-motion: reduce) {

    .why-us-header {
      opacity: 1;
      transform: none;
      transition: none;
    }


    .why-us-card {
      opacity: 1;
      transform: none;
      animation: none;
      transition: none;
    }


    .why-us-icon {
      transition: none;
    }

  }

</style>


<script>

  /* =================================================
     WHY US SECTION OBSERVER
  ================================================= */

  const whyUsSection =
    document.querySelector(".why-us-section");


  if (whyUsSection) {

    const observer =
      new IntersectionObserver(
        (entries) => {

          entries.forEach((entry) => {

            if (entry.isIntersecting) {

              /*
                Tambahkan class untuk
                menjalankan animasi
              */
              entry.target.classList.add(
                "is-visible"
              );


              /*
                Animasi hanya dijalankan
                satu kali
              */
              observer.unobserve(
                entry.target
              );

            }

          });

        },
        {
          /*
            Animasi mulai ketika sekitar
            20% section terlihat.
          */
          threshold: 0.2,
        }
      );


    observer.observe(
      whyUsSection
    );

  }

</script>