---
import Container from "../common/Container.astro";
import Button from "../common/Button.astro";
import heroVisual from "../../assets/images/it-solution-hero.svg";
---

<section
  id="home"
  class="relative min-h-screen overflow-hidden bg-[#171d24] text-white"
>
  <!-- Background Glow -->
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-[500px] w-[500px] rounded-full bg-indigo-600/10 blur-[140px]"
  ></div>

  <div
    class="pointer-events-none absolute -bottom-40 left-1/3 h-[400px] w-[400px] rounded-full bg-blue-600/5 blur-[140px]"
  ></div>

  <Container>
    <div
      class="
        grid
        min-h-screen
        items-center
        gap-12
        py-24

        lg:grid-cols-[1fr_500px]
        lg:gap-8

        xl:grid-cols-[1fr_560px]
        xl:gap-12
      "
    >

      <!-- ================================= -->
      <!-- LEFT CONTENT -->
      <!-- ================================= -->

      <div class="relative z-10 min-w-0">

        <!-- Heading -->
        <h1
          class="
            max-w-[760px]
            text-5xl
            font-bold
            leading-[1.05]
            tracking-[-0.04em]

            sm:text-6xl
            lg:text-[64px]
            xl:text-[70px]
          "
        >
          Technology

          <span
            class="
              bg-gradient-to-r
              from-indigo-400
              via-violet-500
              to-indigo-400
              bg-clip-text
              text-transparent
            "
          >
            Solutions
          </span>

          <br />

          For Your Business
        </h1>


        <!-- Description -->
        <p
          class="
            mt-8
            max-w-[650px]
            text-base
            leading-8
            text-slate-400

            sm:text-lg
          "
        >
          We help businesses transform their ideas into powerful digital
          experiences through modern technology and innovative IT solutions.
        </p>


        <!-- CTA -->
        <div class="mt-9 flex flex-wrap gap-4">

          <Button href="#contact">
            Get Started
          </Button>

          <Button href="#services" variant="outline">
            Explore Services
          </Button>

        </div>

      </div>


      <!-- ================================= -->
      <!-- RIGHT SVG VISUAL -->
      <!-- ================================= -->

      <div
        class="
          relative
          flex
          w-full
          items-center
          justify-center

          lg:justify-end
        "
      >

        <!-- Glow behind SVG -->
        <div
          class="
            pointer-events-none
            absolute
            right-10
            top-1/2
            h-[380px]
            w-[380px]
            -translate-y-1/2
            rounded-full
            bg-indigo-600/10
            blur-[100px]
          "
        ></div>


        <!-- SVG -->
        <img
          src={heroVisual.src}
          alt="IT Solutions - Web Development and Mobile Development"
          class="
            relative
            z-10
            h-auto
            w-full
            max-w-[560px]
            object-contain

            drop-shadow-[0_20px_60px_rgba(79,70,229,0.15)]

            transition-transform
            duration-500
            hover:scale-[1.02]
          "
        />

      </div>

    </div>
  </Container>
</section>