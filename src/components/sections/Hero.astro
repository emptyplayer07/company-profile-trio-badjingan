---
import Container from "../common/Container.astro";
import Button from "../common/Button.astro";
---

<section id="home" class="relative min-h-screen overflow-hidden bg-white text-slate-900">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-125 w-125 rounded-full bg-indigo-100/50 blur-[120px]">
  </div>
  <div 
    class="pointer-events-none absolute -bottom-40 left-1/4 h-100 w-100 rounded-full bg-blue-100/40 blur-[120px]">
  </div>
  <Container>
    <div class="flex min-h-screen items-center justify-center py-24">
      <!-- HERO CONTENT -->
      <div class="relative z-10 mx-auto max-w-4xl text-center">
        <!-- Heading -->
        <h1 class="text-5xl font-bold leading-[1.05] tracking-[-0.04em] text-slate-900 sm:text-6xl lg:text-[72px] xl:text-[80px]">
          Technology Solutions
          <br />
          For Your Business
        </h1>
        <!-- Description -->
        <p class="mx-auto mt-8 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          We help businesses transform their ideas into powerful digital
          experiences through modern technology and innovative IT solutions.
        </p>
        <!-- CTA -->
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <Button href="#contact">
            Get Started
          </Button>
          <Button href="#services" variant="outline">
            Explore Services
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>