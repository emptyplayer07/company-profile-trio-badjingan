---
import Container from "../common/Container.astro";
import Button from "../common/Button.astro";
---

<section
  id="home"
  class="relative min-h-screen overflow-hidden bg-white text-slate-900"
>
  <!-- Background glow -->
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-125 w-125 rounded-full bg-indigo-100/50 blur-[120px] animate-float-slow"
  ></div>

  <div
    class="pointer-events-none absolute -bottom-40 left-1/4 h-100 w-100 rounded-full bg-blue-100/40 blur-[120px] animate-float-reverse"
  ></div>

  <Container>
    <div class="flex min-h-screen items-center justify-center py-24">
      <div class="relative z-10 mx-auto max-w-4xl text-center">

        <!-- Heading -->
        <h1 class="hero-title text-5xl font-bold leading-[1.05] tracking-[-0.04em] text-slate-900 sm:text-6xl lg:text-[72px] xl:text-[80px]">
          Technology Solutions
          <br />
          For Your Business
        </h1>

        <!-- Description -->
        <p class="hero-description mx-auto mt-8 max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
          We help businesses transform their ideas into powerful digital
          experiences through modern technology and innovative IT solutions.
        </p>

        <!-- Buttons -->
        <div class="hero-buttons mt-9 flex flex-wrap justify-center gap-4">
          <Button href="#contact">
            Get Started
          </Button>
          <Button href="#services" variant="outline">
            Explore Services
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Heading */
  .hero-title {
    opacity: 0;
    transform: translateY(40px);
    animation: heroFadeUp 0.9s ease-out forwards;
  }

  /* Description */
  .hero-description {
    opacity: 0;
    transform: translateY(30px);
    animation: heroFadeUp 0.9s ease-out 0.2s forwards;
  }

  /* Buttons */
  .hero-buttons {
    opacity: 0;
    transform: translateY(25px);
    animation: heroFadeUp 0.9s ease-out 0.4s forwards;
  }

  /* Background kanan */
  .animate-float-slow {
    animation: floatSlow 8s ease-in-out infinite;
  }

  /* Background kiri */
  .animate-float-reverse {
    animation: floatReverse 10s ease-in-out infinite;
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes floatSlow {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(-30px, 25px);
    }
  }

  @keyframes floatReverse {
    0%,
    100% {
      transform: translate(0, 0);
    }

    50% {
      transform: translate(25px, -20px);
    }
  }

  /* Menghormati user yang mematikan animasi */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-description,
    .hero-buttons,
    .animate-float-slow,
    .animate-float-reverse {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>